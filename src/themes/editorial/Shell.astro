---
// The shell of the Editorial light look (board 1): a masthead with the brand and a double rule, an uppercase link row
// with the account at the right, and from lg an account column beside the page.
// Under sm the masthead folds to one row with the brand and the phone menu.
import Brand from "@/components/Brand.astro";
import PhoneMenu from "@/components/PhoneMenu.astro";
import { accountLinks, currentNavHref, navLinks } from "@/lib/nav";

const { user } = Astro.locals;
const currentHref = currentNavHref(Astro.url.pathname);
const isCurrent = (href: string) => href === currentHref;
const rowLink = "inline-flex min-h-11 min-w-11 items-center transition-colors hover:text-primary";
---

<div class="min-h-screen w-full bg-background text-foreground">
  {/* On a phone the double rule sits under the bar. From sm it sits under the masthead row inside the bar. */}
  <header class="mx-auto w-full max-w-280 border-b-[3px] border-double border-foreground px-4 sm:border-b-0 sm:px-6 sm:pt-8">
    {/* One element is the bar on a phone and the masthead with the link row from sm. On a phone it is one row: 44px plus py-2. */}
    <nav
      data-testid="shell-nav"
      aria-label="Main"
      class="relative flex flex-wrap items-center justify-between gap-x-3 py-2 sm:block sm:py-0"
    >
      {/* Under sm this row takes the free space of the bar and the brand shortens a long name, so the bar stays one row. */}
      <div class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-3 sm:border-b-[3px] sm:border-double sm:border-foreground sm:pb-4">
        <Brand
          unstyled
          class="inline-flex font-heading text-xl font-semibold tracking-tight sm:text-[40px]"
          nameClass="min-w-0 truncate sm:overflow-visible sm:whitespace-normal"
        />
        <span class="hidden text-[13px] tracking-[0.08em] text-muted-foreground uppercase sm:inline">
          Your workspace
        </span>
      </div>
      {!user && (
        <div class="flex items-center gap-3 text-[13px] tracking-[0.08em] uppercase sm:justify-end sm:border-b sm:border-foreground sm:py-1">
          <a href="/auth/signin" class:list={[rowLink, "text-foreground"]}>
            Sign in
          </a>
          <a href="/auth/signup" class:list={[rowLink, "font-semibold text-primary"]}>
            Sign up
          </a>
        </div>
      )}
      {user && (
        <>
          <div class="hidden flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-foreground py-1 text-[13px] tracking-[0.08em] uppercase sm:flex">
            <div class="flex gap-6">
              {navLinks.map(({ href, label }) => (
                <a
                  href={href}
                  aria-current={isCurrent(href) ? "page" : undefined}
                  class:list={[
                    rowLink,
                    isCurrent(href)
                      ? "font-semibold text-foreground underline underline-offset-[6px]"
                      : "text-muted-foreground",
                  ]}
                >
                  {label}
                </a>
              ))}
            </div>
            <div class="flex min-w-0 items-center gap-4">
              <span class="max-w-[16rem] truncate tracking-normal text-muted-foreground normal-case" title={user.email}>
                {user.email}
              </span>
              {accountLinks.map(({ href, label }) => (
                <a
                  href={href}
                  aria-current={isCurrent(href) ? "page" : undefined}
                  class:list={[
                    "inline-flex min-h-11 min-w-11 items-center tracking-[0.08em] uppercase transition-colors",
                    isCurrent(href)
                      ? "font-semibold text-foreground underline underline-offset-[6px]"
                      : "text-primary hover:text-foreground",
                  ]}
                >
                  {label}
                </a>
              ))}
              <form method="POST" action="/api/auth/signout">
                <button
                  type="submit"
                  class="inline-flex min-h-11 min-w-11 cursor-pointer items-center tracking-[0.08em] text-primary uppercase transition-colors hover:text-foreground"
                >
                  Sign out
                </button>
              </form>
            </div>
          </div>
          <PhoneMenu />
        </>
      )}
    </nav>
  </header>
  <div class="mx-auto flex w-full max-w-280 gap-12 px-4 pt-8 pb-16 sm:px-6 sm:pt-10">
    <main data-testid="app-shell" class="min-w-0 flex-1">
      <slot />
    </main>
    {user && (
      <aside class="hidden w-65 flex-none self-start border-t-[3px] border-foreground pt-4 lg:block">
        <h2 class="mb-2 text-[13px] font-semibold tracking-[0.08em] uppercase">Your account</h2>
        <p class="mb-4 font-heading text-xl break-all">{user.email}</p>
        <p class="text-sm leading-normal text-muted-foreground">Only you see the records in this workspace.</p>
      </aside>
    )}
  </div>
</div>
