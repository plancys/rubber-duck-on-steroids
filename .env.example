SUPABASE_URL=###
SUPABASE_KEY=###
# Set to true to let the cookie "look" select the look of the page, for a local preview or a check.
# Production must not set it.
# ALLOW_LOOK_OVERRIDE=true
# The OAuth providers on the sign-in and sign-up pages, as a comma-separated list: github, google.
# Without the setting, the pages show no OAuth button. Each provider also needs its client values in Supabase.
# A local Supabase reads them from SUPABASE_AUTH_EXTERNAL_<PROVIDER>_CLIENT_ID and _SECRET (see supabase/config.toml).
# OAUTH_PROVIDERS=github,google
# Set to true to open /dashboard/job-check, the page that starts the demo job, for a local check or CI.
# Production keeps the switch off.
# ENABLE_JOB_CHECK=true
# Set to true to let a course URL name a private address, such as localhost, for a local fixture site or CI.
# node scripts/fixture-server.mjs serves the fixture course at http://localhost:8799/duck-basics.
# Production keeps the switch off.
# ALLOW_PRIVATE_COURSE_URLS=true
# The web app does not read ANTHROPIC_API_KEY. Do not put it in this file.
# The worker reads it from its own environment: ANTHROPIC_API_KEY=<key> npm run worker.
# Production keeps it in Google Secret Manager as worker-anthropic-api-key.
# Without the key, the worker picks the lessons with its rule: the links under the path of the start page.
# The wake request that the app sends to the worker after it creates a job. These are the values of npm run worker.
# WORKER_WAKE_URL=http://localhost:8788/wake
# WORKER_WAKE_SECRET=local-wake-secret
# The topic engine values are for the worker. The web app does not read them.
# The worker reads them from its own environment: TOPIC_ENGINE_URL=<address> TOPIC_ENGINE_SECRET=<secret> npm run worker.
# Without them, npm run worker uses the values of npm run engine below.
# Production sets TOPIC_ENGINE_URL as a GitHub variable and keeps the secret in Google Secret Manager as engine-secret.
# Without an engine address, the worker fails each topic job with a safe reason.
# TOPIC_ENGINE_URL=http://127.0.0.1:8790
# TOPIC_ENGINE_SECRET=local-engine-secret
