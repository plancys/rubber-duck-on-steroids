---
import Layout from "@/layouts/Layout.astro";
import Brand from "@/components/Brand.astro";
import SignInForm from "@/components/auth/SignInForm";
import OAuthButtons from "@/components/auth/OAuthButtons.astro";
import { authErrorText, authNoticeText } from "@/lib/auth-errors";
import { safeNextPath } from "@/lib/safe-next";

const error = authErrorText(Astro.url.searchParams.get("error"));
const notice = authNoticeText(Astro.url.searchParams.get("notice"));
const next = safeNextPath(Astro.url.searchParams.get("next"), Astro.url.origin);
---

<Layout title="Sign in">
  <div class="flex min-h-screen flex-col items-center justify-center gap-6 bg-background p-4 text-foreground">
    <Brand mark class="text-xl" />
    <div class="w-full max-w-sm rounded-(--radius) bg-card p-6 text-card-foreground shadow-(--shadow-card) sm:p-8">
      <h1 class="mb-6 text-center font-heading text-2xl font-extrabold">Sign in</h1>
      {notice && (
        <p data-testid="auth-notice" class="mb-4 rounded-lg bg-success px-3 py-2 text-sm text-success-foreground">
          {notice}
        </p>
      )}
      <SignInForm serverError={error} next={next} client:load />
      <OAuthButtons next={next} />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        Don't have an account?{" "}
        <a
          href="/auth/signup"
          class="inline-flex min-h-11 min-w-11 items-center font-semibold text-primary hover:underline"
        >
          Sign up
        </a>
      </p>
    </div>
  </div>
</Layout>
