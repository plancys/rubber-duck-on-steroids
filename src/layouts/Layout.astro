---
import "../styles/global.css";
import { Font, type CssVariable } from "astro:assets";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { activeLook, type Look } from "@/lib/looks";
import { site } from "@/lib/site";

interface Props {
  title?: string;
}

const { title = site.name } = Astro.props;
const look = activeLook(Astro.cookies);

// The fonts of each look, from the fonts option in astro.config.mjs. The page loads only the fonts of the active look.
const lookFonts: Record<Look, CssVariable[]> = {
  warm: ["--font-nunito"],
  editorial: ["--font-fraunces", "--font-inter"],
  calm: ["--font-inter"],
  swiss: ["--font-archivo"],
  dock: ["--font-plus-jakarta-sans"],
};
---

<!doctype html>
<html lang="en" data-theme={look}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    {lookFonts[look].map((cssVariable) => (
      <Font cssVariable={cssVariable} />
    ))}
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
