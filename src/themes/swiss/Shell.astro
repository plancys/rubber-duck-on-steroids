---
// The shell of the Swiss grid look (board 5): a left index rail from md with numbered links and the account at the bottom.
// Under md the rail folds to one row with the brand and the phone menu.
import Brand from "@/components/Brand.astro";
import PhoneMenu from "@/components/PhoneMenu.astro";
import { accountLinks, currentNavHref, navLinks } from "@/lib/nav";

const { user } = Astro.locals;
const currentHref = currentNavHref(Astro.url.pathname);
const isCurrent = (href: string) => href === currentHref;
const number = (index: number) => String(index + 1).padStart(2, "0");
---

<div class="min-h-screen w-full bg-background text-foreground md:flex">
  {/* One element is the bar on a phone and the rail from md. On a phone it is one row: 44px plus py-2. */}
  <nav
    data-testid="shell-nav"
    aria-label="Main"
    class="relative flex flex-wrap items-center justify-between gap-x-1 border-b-2 border-foreground px-3 py-2 md:sticky md:top-0 md:h-screen md:w-52 md:flex-none md:flex-col md:flex-nowrap md:items-stretch md:justify-start md:border-r-2 md:border-b-0 md:px-6 md:py-8"
  >
    <Brand
      unstyled
      class="flex px-1 text-[15px] font-extrabold tracking-wide uppercase transition-colors hover:text-accent-foreground md:mb-12 md:px-0"
    />
    {!user && (
      <div class="flex items-center gap-1 md:flex-col md:items-stretch md:gap-0">
        <a
          href="/auth/signin"
          class="flex min-h-11 min-w-11 items-center justify-center px-2 font-extrabold transition-colors hover:text-accent-foreground md:justify-start md:border-t-2 md:border-foreground md:px-0"
        >
          Sign in
        </a>
        <a
          href="/auth/signup"
          class="flex min-h-11 min-w-11 items-center justify-center bg-primary px-3 font-extrabold text-primary-foreground transition-colors hover:bg-primary/90 md:justify-start"
        >
          Sign up
        </a>
      </div>
    )}
    {user && (
      <>
        <div class="hidden flex-1 flex-col md:flex">
          {navLinks.map(({ href, label }, index) => (
            <a
              href={href}
              aria-current={isCurrent(href) ? "page" : undefined}
              class:list={[
                "flex min-h-11 min-w-11 items-baseline gap-3 border-foreground py-2 transition-colors hover:text-accent-foreground",
                index === 0 ? "border-t-2" : "border-t",
                isCurrent(href) ? "font-extrabold text-accent-foreground" : "text-foreground",
              ]}
            >
              <span class="text-xs">{number(index)}</span>
              {label}
            </a>
          ))}
          <div class="mt-auto flex flex-col pt-8">
            <span class="text-xs break-all text-muted-foreground">{user.email}</span>
            {accountLinks.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isCurrent(href) ? "page" : undefined}
                class:list={[
                  "flex min-h-11 min-w-11 items-center font-extrabold transition-colors hover:text-accent-foreground",
                  isCurrent(href) ? "text-accent-foreground" : "text-foreground",
                ]}
              >
                {label}
              </a>
            ))}
            <form method="POST" action="/api/auth/signout">
              <button
                type="submit"
                class="flex min-h-11 min-w-11 cursor-pointer items-center font-extrabold text-foreground transition-colors hover:text-accent-foreground"
              >
                Sign out ↗
              </button>
            </form>
          </div>
        </div>
        <PhoneMenu breakpoint="md" />
      </>
    )}
  </nav>
  <main data-testid="app-shell" class="min-w-0 flex-1 px-4 pt-6 pb-16 md:px-12 md:pt-8">
    <slot />
  </main>
</div>
