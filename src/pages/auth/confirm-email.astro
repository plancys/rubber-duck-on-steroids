---
import Layout from "@/layouts/Layout.astro";
import Brand from "@/components/Brand.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen flex-col items-center justify-center gap-6 bg-background p-4 text-foreground">
    <Brand mark class="text-xl" />
    <div class="w-full max-w-sm rounded-(--radius) bg-card p-6 text-center text-card-foreground shadow-(--shadow-card) sm:p-8">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="mb-3 font-heading text-2xl font-extrabold">{content.heading}</h1>
      <p class="mb-6 text-muted-foreground">{content.description}</p>
      <a
        href="/auth/signin"
        class="inline-flex min-h-11 min-w-11 items-center text-sm font-semibold text-primary hover:underline"
      >
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
