SUPABASE_URL=###
SUPABASE_KEY=###
# Set to true to let the cookie "look" select the look of the page, for a local preview or a check.
# Production must not set it.
# ALLOW_LOOK_OVERRIDE=true
# The OAuth providers on the sign-in and sign-up pages, as a comma-separated list: github, google.
# Without the setting, the pages show no OAuth button. Each provider also needs its client values in Supabase.
# A local Supabase reads them from SUPABASE_AUTH_EXTERNAL_<PROVIDER>_CLIENT_ID and _SECRET (see supabase/config.toml).
# OAUTH_PROVIDERS=github,google
