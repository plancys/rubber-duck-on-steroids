---
// The container of the dashboard entries, in the form of the active look.
// Editorial and Swiss show a number on each entry. The list resets a CSS counter, and each Entry counts up.
import { activeLook } from "@/lib/looks";

const look = activeLook(Astro.cookies);
---

{look === "warm" && (
  <section class="flex flex-col gap-6">
    <slot />
  </section>
)}
{look === "editorial" && (
  <ol class="list-none border-t border-foreground [counter-reset:entry]">
    <slot />
  </ol>
)}
{look === "calm" && (
  <section class="grid gap-4 sm:grid-cols-[repeat(auto-fill,minmax(260px,1fr))]">
    <slot />
  </section>
)}
{look === "swiss" && (
  <section class="[counter-reset:entry]">
    {/* The column heads of the table-like list. A screen reader reads each row as one link, so the heads are hidden from it. */}
    <div
      aria-hidden="true"
      class="hidden grid-cols-[3rem_minmax(0,14rem)_1fr_auto] gap-4 border-b-2 border-foreground py-2 text-xs font-extrabold tracking-widest md:grid"
    >
      <span>NO.</span>
      <span>SECTION</span>
      <span>DESCRIPTION</span>
      <span class="text-right">ACTION</span>
    </div>
    <slot />
  </section>
)}
{look === "dock" && (
  <section class="grid gap-5 sm:grid-cols-[repeat(auto-fill,minmax(240px,1fr))]">
    <slot />
  </section>
)}
