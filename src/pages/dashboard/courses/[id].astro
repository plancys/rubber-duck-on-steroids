---
import { ListChecks, Network, RotateCcw, Waypoints } from "lucide-react";
import AppLayout from "@/layouts/AppLayout.astro";
import JobStatus from "@/components/jobs/JobStatus";
import DeleteCourseButton from "@/components/courses/DeleteCourseButton";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";
import { JOB_VIEW_COLUMNS, toJobView, type JobView } from "@/lib/jobs";
import { courseErrorText, courseName, courseStatusText, isCourseId } from "@/lib/courses";
import {
  lessonPath,
  pathCounts,
  readLessonPath,
  type CourseLessonMap,
  type PathGap,
  type PathLesson,
  type PathMove,
  type PathTopic,
} from "@/lib/lesson-path";
import {
  buildTimeText,
  knownTopicsPath,
  topicCountText,
  topicMapPath,
  topicMapStatus,
  type TopicMapStateRow,
} from "@/lib/topics";
import type { Tables } from "@/db/database.types";

let error = courseErrorText(Astro.url.searchParams.get("error"));

type Course = Pick<
  Tables<"courses">,
  "id" | "title" | "source_url" | "source_kind" | "status" | "error" | "loaded_at" | "created_at"
>;
type Lesson = Pick<Tables<"lessons">, "id" | "position" | "title" | "url" | "status" | "error">;

// A course of another learner and an id that does not exist give the same result. RLS returns no row for both.
const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
let course: Course | null = null;
let lessons: Lesson[] = [];
let job: JobView | null = null;
let topicJob: JobView | null = null;
let mapState: TopicMapStateRow | null = null;
// The lesson map of the course and the live topics that the learner knows. The adjusted lesson list joins them.
let lessonMap: CourseLessonMap | null = null;
let knownTopics: ReadonlySet<string> = new Set<string>();
// True when the reads of the adjusted list fail. Then the page shows the course order and a notice.
let pathFailed = false;
let notFound = false;
if (!supabase) {
  error = courseErrorText("not_configured");
} else if (!isCourseId(id)) {
  notFound = true;
} else {
  const courseResult = await supabase
    .from("courses")
    .select("id, title, source_url, source_kind, status, error, loaded_at, created_at")
    .eq("id", id)
    .maybeSingle();
  if (courseResult.error) {
    Astro.response.status = 500;
    error = courseErrorText("unknown");
  } else if (!courseResult.data) {
    notFound = true;
  } else {
    course = courseResult.data;
    // The lesson text stays in the database. This page shows the list only.
    // A course holds at most 500 lessons. The limit keeps the read small, also for a course that breaks that rule.
    const [lessonResult, jobResult, topicJobResult, mapStateResult, pathMarks] = await Promise.all([
      supabase
        .from("lessons")
        .select("id, position, title, url, status, error")
        .eq("course_id", id)
        .order("position", { ascending: true })
        .limit(500),
      // The newest load job of the course. A course from the extension has no load job.
      supabase
        .from("jobs")
        .select(JOB_VIEW_COLUMNS)
        .eq("type", "load_course")
        .eq("payload->>courseId", id)
        .order("created_at", { ascending: false })
        .limit(1)
        .maybeSingle(),
      // The newest topic job of the course.
      supabase
        .from("jobs")
        .select(JOB_VIEW_COLUMNS)
        .eq("type", "build_topic_map")
        .eq("payload->>courseId", id)
        .order("created_at", { ascending: false })
        .limit(1)
        .maybeSingle(),
      // The state of the map: the build time and the lesson counts. It reads no lesson text.
      supabase.rpc("topic_map_state", { course_id: id }),
      // The lesson map and the events of the learner. No database function joins them, so the page joins them.
      readLessonPath(supabase, id),
    ]);
    if (lessonResult.error || jobResult.error || topicJobResult.error || mapStateResult.error) {
      Astro.response.status = 500;
      error = courseErrorText("unknown");
    } else {
      lessons = lessonResult.data;
      job = jobResult.data ? toJobView(jobResult.data) : null;
      topicJob = topicJobResult.data ? toJobView(topicJobResult.data) : null;
      mapState = mapStateResult.data[0] ?? null;
      // The adjusted list is an extra. When its reads fail, the page keeps the course order and shows a notice.
      if ("error" in pathMarks) {
        pathFailed = true;
      } else {
        lessonMap = pathMarks.map;
        knownTopics = pathMarks.known;
      }
    }
  }
}

if (notFound) {
  Astro.response.status = 404;
}

// A failed attempt marks the course failed, and the job waits for its next start. So the job state also counts.
const jobInProgress = job !== null && (job.status === "waiting" || job.status === "running");
const loads = course !== null && (course.status === "loading" || jobInProgress);
// A course in "loading" without a job in progress does not change any more.
const stuck = course !== null && course.status === "loading" && !jobInProgress;
// A learner has one job in progress. So the Reload button and the map button stay hidden while a job of the course runs.
const topicJobInProgress = topicJob !== null && (topicJob.status === "waiting" || topicJob.status === "running");
const canReload = course !== null && course.source_kind === "crawl" && !loads && !topicJobInProgress;
const loadedCount = lessons.filter((lesson) => lesson.status === "loaded").length;
const mapStatus = topicMapStatus(mapState);
const canBuildMap = course !== null && course.status === "ready" && !loads && !topicJobInProgress;
// The lessons with no analysis of their current text: failed lessons, new lessons and changed lessons.
const notAnalysed = mapState ? Math.max(0, mapState.loaded_lessons - mapState.analysed_lessons) : 0;
// The adjusted lesson list needs a map. A course with no map shows the lessons in course order.
const path = lessonMap && mapStatus !== "none" ? lessonPath(lessons, lessonMap, knownTopics) : null;
const counts = path ? pathCounts(path) : null;

// The reason of a skipped lesson, for example "You know all 3 topics it explains."
function skippedText(topics: number): string {
  return topics === 1 ? "You know the 1 topic it explains." : `You know all ${topics} topics it explains.`;
}

// The reason of a moved lesson. The topic of the later lesson needs the prerequisite, which this lesson explains first.
function movedText(move: PathMove): string {
  const reasons = move.pairs.map(
    (pair) => `"${pair.topic}" in lesson ${move.position} needs "${pair.prerequisite}", which this lesson explains.`,
  );
  return `Moved up: ${reasons.join(" ")}`;
}

// The gap note of a topic whose prerequisite no lesson explains. The home lesson of the prerequisite mentions it.
// position is the course position of the lesson of the note.
function gapText(gap: PathGap, position: number): string {
  let mention = "";
  if (gap.mentionPosition === position) mention = " This lesson mentions it.";
  else if (gap.mentionPosition !== null) mention = ` Lesson ${gap.mentionPosition} mentions it.`;
  return `"${gap.topic}" needs "${gap.prerequisite}". No lesson explains it.${mention}`;
}

// The name of a lesson: its title, else its URL.
function lessonName(lesson: PathLesson): string {
  return lesson.title?.trim() ? lesson.title : lesson.url;
}

// The ids of the notes of a lesson. The link of the lesson points a screen reader at the state note and the move note.
function stateId(lesson: PathLesson): string {
  return `lesson-${lesson.position}-state`;
}

function movedId(lesson: PathLesson): string {
  return `lesson-${lesson.position}-moved`;
}

function describedBy(lesson: PathLesson): string {
  return lesson.movedUp ? `${stateId(lesson)} ${movedId(lesson)}` : stateId(lesson);
}

// The name of a topic link for a screen reader. The link opens the checklist, where one click changes the mark.
function topicLinkLabel(topic: PathTopic): string {
  return `${topic.name}, ${topic.known ? "known" : "not marked"}. Change the mark on the checklist.`;
}

// The parts that both lists share: the item, the course position and the link to the original lesson.
const lessonItemClass =
  "flex items-start gap-3 rounded-lg bg-card px-4 py-2 text-card-foreground shadow-(--shadow-card)";
const lessonPositionClass =
  "flex min-h-11 min-w-8 flex-none items-center font-heading font-extrabold text-muted-foreground";
const lessonLinkClass = "block min-h-11 min-w-11 py-2.5 font-bold [overflow-wrap:anywhere] hover:underline";
---

<AppLayout title={course ? courseName(course) : "Course not found"}>
  {course ? (
    <>
      <p class="mb-2 text-sm">
        <a
          href="/dashboard/courses"
          class="inline-flex min-h-11 min-w-11 items-center font-semibold text-muted-foreground hover:text-foreground"
        >
          All courses
        </a>
      </p>
      <h1 class="mb-2 font-heading text-3xl font-extrabold [overflow-wrap:anywhere] sm:text-4xl">
        {courseName(course)}
      </h1>
      <p class="mb-6 text-sm">
        <a
          href={course.source_url}
          target="_blank"
          rel="noopener noreferrer"
          data-testid="course-source-link"
          class="inline-flex min-h-11 min-w-11 items-center break-all text-primary underline underline-offset-2"
        >
          {course.source_url}
        </a>
      </p>
      {error && (
        <div data-testid="course-error" class="mb-6">
          <ServerError message={error} />
        </div>
      )}

      <section
        data-testid="course-state"
        data-status={jobInProgress ? "loading" : course.status}
        class="mb-8 space-y-3 rounded-(--radius) bg-card p-6 text-card-foreground shadow-(--shadow-card)"
      >
        <h2 class="font-heading text-xl font-extrabold">
          {courseStatusText(jobInProgress ? "loading" : course.status)}
        </h2>
        {course.source_kind === "extension" && (
          <p class="text-sm text-muted-foreground">
            This course comes from the browser extension. Open a lesson page with the extension on to add it.
          </p>
        )}
        {jobInProgress && job && <JobStatus job={job} retry={false} reloadOnEnd client:load />}
        {stuck && (
          <p data-testid="course-stuck" class="text-sm text-muted-foreground">
            The load stopped. Delete the course and load it again.
          </p>
        )}
        {!loads && course.status === "failed" && <ServerError message={course.error ?? "The course did not load."} />}
        {!loads && course.status === "ready" && (
          <p class="text-sm text-muted-foreground">
            {loadedCount} of {lessons.length} {lessons.length === 1 ? "lesson" : "lessons"} loaded
            {course.loaded_at && ` on ${course.loaded_at.slice(0, 10)}`}.
          </p>
        )}
        <div class="grid gap-3 sm:grid-cols-2">
          {canReload && (
            <form method="POST" action={`/api/courses/${course.id}/reload`}>
              <button
                type="submit"
                data-testid="course-reload-button"
                class="flex min-h-11 w-full min-w-11 items-center justify-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground transition-colors hover:bg-primary/90"
              >
                <RotateCcw className="size-4" aria-hidden="true" />
                Reload course
              </button>
            </form>
          )}
          <DeleteCourseButton courseId={course.id} client:load />
        </div>
      </section>

      <section
        data-testid="topic-map-state"
        data-status={topicJobInProgress ? "building" : mapStatus}
        class="mb-8 space-y-3 rounded-(--radius) bg-card p-6 text-card-foreground shadow-(--shadow-card)"
      >
        <h2 class="font-heading text-xl font-extrabold">Topic map</h2>
        {topicJobInProgress && topicJob && <JobStatus job={topicJob} retry={false} reloadOnEnd client:load />}
        {!topicJobInProgress && topicJob?.status === "failed" && (
          <div data-testid="topic-job-failed">
            <ServerError message={topicJob.error ?? "The topic map did not build."} />
          </div>
        )}
        {mapStatus === "none" && !topicJobInProgress && (
          <p class="text-sm text-muted-foreground">
            {course.status === "ready"
              ? "This course has no topic map yet."
              : "The topic map needs a ready course. It builds after the course loads."}
          </p>
        )}
        {mapState && mapStatus !== "none" && (
          <p data-testid="topic-map-counts" class="text-sm text-muted-foreground">
            {topicCountText(mapState.topic_count)} from {mapState.analysed_lessons} of {mapState.loaded_lessons}{" "}
            {mapState.loaded_lessons === 1 ? "lesson" : "lessons"}.
            {mapState.built_at && ` Built on ${buildTimeText(mapState.built_at)}.`}
          </p>
        )}
        {mapStatus === "stale" && !topicJobInProgress && (
          <p data-testid="topic-map-stale" class="text-sm font-semibold">
            The map is older than the lessons. Update the map to analyse the new and changed lessons.
          </p>
        )}
        {mapStatus === "partial" && !topicJobInProgress && (
          <p data-testid="topic-map-partial" class="text-sm font-semibold">
            The engine did not analyse {notAnalysed} of {mapState?.loaded_lessons ?? 0}{" "}
            {mapState?.loaded_lessons === 1 ? "lesson" : "lessons"}. Update the map to try these lessons again.
          </p>
        )}
        {(mapStatus !== "none" || canBuildMap) && (
          <div class="grid gap-3 sm:grid-cols-2">
            {mapStatus !== "none" && (
              <>
                <a
                  href={topicMapPath(course.id)}
                  data-testid="topic-map-link"
                  class="flex min-h-11 w-full min-w-11 items-center justify-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-secondary"
                >
                  <Waypoints className="size-4" aria-hidden="true" />
                  Open the topic map
                </a>
                <a
                  href={knownTopicsPath(course.id)}
                  data-testid="known-link"
                  class="flex min-h-11 w-full min-w-11 items-center justify-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-secondary"
                >
                  <ListChecks className="size-4" aria-hidden="true" />
                  Mark the topics you know
                </a>
              </>
            )}
            {canBuildMap && mapStatus !== "current" && (
              <form method="POST" action={`/api/courses/${course.id}/topics`}>
                <button
                  type="submit"
                  data-testid="topic-map-build-button"
                  class="flex min-h-11 w-full min-w-11 items-center justify-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground transition-colors hover:bg-primary/90"
                >
                  <Network className="size-4" aria-hidden="true" />
                  {mapStatus === "none" ? "Build the topic map" : "Update the map"}
                </button>
              </form>
            )}
          </div>
        )}
      </section>

      <section>
        <h2 class="mb-3 font-heading text-xl font-extrabold">Lessons</h2>
        {lessons.length === 0 ? (
          <p data-testid="lessons-empty" class="text-sm text-muted-foreground">
            {loads ? "The lessons show here when the load ends." : "This course has no lessons yet."}
          </p>
        ) : path && counts ? (
          <>
            <p data-testid="lesson-path-summary" class="mb-3 text-sm text-muted-foreground">
              {knownTopics.size === 0 ? (
                <a
                  href={knownTopicsPath(course.id)}
                  class="inline-flex min-h-11 min-w-11 items-center font-semibold text-primary underline underline-offset-2"
                >
                  Mark the topics you know to skip lessons.
                </a>
              ) : (
                `Adjusted to the topics you know: ${counts.skipped} of ${counts.total} ` +
                `${counts.total === 1 ? "lesson" : "lessons"} skipped, ${counts.moved} moved up.`
              )}
            </p>
            {/* Each item keeps data-testid and data-status first, and the link to the original lesson as its first
                link. The smoke test reads them. */}
            <ol data-testid="lesson-path" class="space-y-2">
              {path.map((lesson) => (
                <li
                  data-testid="lesson-item"
                  data-status={lesson.status}
                  data-position={lesson.position}
                  data-path-state={lesson.state}
                  data-moved={lesson.movedUp ? "true" : "false"}
                  class:list={lessonItemClass}
                >
                  <span class:list={lessonPositionClass}>{lesson.position}</span>
                  <div class="min-w-0 flex-1 space-y-1 pb-2">
                    <a
                      href={lesson.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-describedby={describedBy(lesson)}
                      class:list={lessonLinkClass}
                    >
                      {lessonName(lesson)}
                    </a>
                    {lesson.state === "skipped" && (
                      <p id={stateId(lesson)} class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                        <strong
                          data-testid="lesson-skipped"
                          class="rounded-full bg-secondary px-2 py-0.5 text-xs font-bold text-secondary-foreground"
                        >
                          Skipped
                        </strong>
                        {/* The hidden period gives a screen reader a pause after the label. */}
                        <span class="sr-only">.</span>
                        <span class="text-muted-foreground">{skippedText(lesson.topics.length)}</span>
                      </p>
                    )}
                    {lesson.state === "open" && (
                      <p id={stateId(lesson)} class="text-sm text-muted-foreground">
                        {`You know ${lesson.knownCount} of ${topicCountText(lesson.topics.length)} it explains.`}
                      </p>
                    )}
                    {lesson.state === "not_loaded" && (
                      <p id={stateId(lesson)} data-testid="lesson-failed" class="text-sm text-destructive">
                        Could not load{lesson.error ? `: ${lesson.error}` : ""}
                      </p>
                    )}
                    {lesson.state === "not_analysed" && (
                      <p id={stateId(lesson)} data-testid="lesson-not-analysed" class="text-sm text-muted-foreground">
                        Not analysed yet. The list does not skip it.
                      </p>
                    )}
                    {lesson.state === "no_topics" && (
                      <p id={stateId(lesson)} data-testid="lesson-no-topics" class="text-sm text-muted-foreground">
                        No topics found. The list does not skip it.
                      </p>
                    )}
                    {lesson.movedUp && (
                      <p id={movedId(lesson)} data-testid="lesson-moved" class="text-sm [overflow-wrap:anywhere]">
                        {movedText(lesson.movedUp)}
                      </p>
                    )}
                    {lesson.gaps.map((gap) => (
                      <p data-testid="lesson-gap" class="text-sm [overflow-wrap:anywhere]">
                        {gapText(gap, lesson.position)}
                      </p>
                    ))}
                    {lesson.topics.length > 0 && (
                      <details data-testid="lesson-topics" class="text-sm">
                        <summary class="flex min-h-11 min-w-11 cursor-pointer items-center font-semibold text-primary">
                          Topics of this lesson<span class="sr-only">: {lessonName(lesson)}</span>
                        </summary>
                        {/* Each topic opens its lesson section on the checklist, where one click changes the mark. */}
                        <ul class="space-y-1">
                          {lesson.topics.map((topic) => (
                            <li>
                              <a
                                href={knownTopicsPath(course.id, topic.homePosition ?? undefined)}
                                aria-label={topicLinkLabel(topic)}
                                data-topic-id={topic.id}
                                data-known={topic.known ? "true" : "false"}
                                class="flex min-h-11 min-w-11 items-start justify-between gap-3 rounded-lg px-3 py-2.5 font-semibold transition-colors hover:bg-secondary"
                              >
                                <span class="min-w-0 flex-1 [overflow-wrap:anywhere]">{topic.name}</span>
                                <span
                                  class:list={["flex-none", topic.known ? "text-primary" : "text-muted-foreground"]}
                                >
                                  {topic.known ? "Known" : "Not marked"}
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <>
            {pathFailed && mapStatus !== "none" && (
              <p data-testid="lesson-path-error" class="mb-3 text-sm text-muted-foreground">
                The adjusted list did not load, so the list shows the course order. Reload the page to try again.
              </p>
            )}
            <ol class="space-y-2">
              {lessons.map((lesson) => (
                <li data-testid="lesson-item" data-status={lesson.status} class:list={lessonItemClass}>
                  <span class:list={lessonPositionClass}>{lesson.position}</span>
                  <div class="min-w-0 flex-1">
                    <a href={lesson.url} target="_blank" rel="noopener noreferrer" class:list={lessonLinkClass}>
                      {lesson.title?.trim() ? lesson.title : lesson.url}
                    </a>
                    {lesson.status === "failed" && (
                      <p data-testid="lesson-failed" class="pb-2 text-sm text-destructive">
                        Could not load{lesson.error ? `: ${lesson.error}` : ""}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </>
        )}
      </section>
    </>
  ) : (
    <>
      <h1 class="mb-6 font-heading text-3xl font-extrabold sm:text-4xl">{notFound ? "Course not found" : "Course"}</h1>
      <p class="text-sm text-muted-foreground">{notFound ? courseErrorText("not_found") : error}</p>
    </>
  )}
</AppLayout>
