---
import * as Entries from "@/components/entries";
import AppLayout from "@/layouts/AppLayout.astro";

const { user } = Astro.locals;
---

<AppLayout title="Dashboard">
  <div class="mb-6 text-center">
    <h1 class="mt-2 mb-1 font-heading text-4xl font-extrabold sm:text-5xl">Dashboard</h1>
    <p class="text-muted-foreground">
      Signed in as{" "}
      <span class="inline-block max-w-[14rem] truncate align-bottom font-semibold text-foreground" title={user?.email}>
        {user?.email}
      </span>
    </p>
  </div>
  <Entries.EntryList>
    {/* A new signed-in page adds one Entries.Entry here. The comment also keeps the list open after remove:sample. */}
    {/* BEGIN sample-resource */}
    <Entries.Entry
      title="Notes"
      description="Your private notes. Write, edit and delete them."
      href="/dashboard/notes"
      testid="notes-link"
    />
    {/* END sample-resource */}
  </Entries.EntryList>
</AppLayout>
