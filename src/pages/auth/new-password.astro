---
import Layout from "@/layouts/Layout.astro";
import Brand from "@/components/Brand.astro";
import NewPasswordForm from "@/components/auth/NewPasswordForm";
import { authErrorText } from "@/lib/auth-errors";
import { createClient } from "@/lib/supabase";
import { isRecoverySession } from "@/lib/recovery";

// Only a session from a reset link can open this page. A normal sign-in cannot change the password here.
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase || !(await isRecoverySession(supabase))) {
  return Astro.redirect("/auth/reset?error=link_invalid");
}

const error = authErrorText(Astro.url.searchParams.get("error"));
---

<Layout title="Set a new password">
  <div class="flex min-h-screen flex-col items-center justify-center gap-6 bg-background p-4 text-foreground">
    <Brand mark class="text-xl" />
    <div class="w-full max-w-sm rounded-(--radius) bg-card p-6 text-card-foreground shadow-(--shadow-card) sm:p-8">
      <h1 class="mb-6 text-center font-heading text-2xl font-extrabold">Set a new password</h1>
      <div data-testid="new-password-form">
        <NewPasswordForm serverError={error} client:load />
      </div>
    </div>
  </div>
</Layout>
